{
  "name": "sagewiki",
  "version": "0.1.0",
  "description": "Typed zero-dependency client for sage-wiki's /v1 REST API (pre-1.0 — pin a version)",
  "repository": {
    "type": "git",
    "url": "https://github.com/xoai/sage-wiki",
    "directory": "clients/typescript"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist-test/test/*.test.js",
    "test:contract": "node --test dist-test/test/contract.test.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.5.0"
  }
}
